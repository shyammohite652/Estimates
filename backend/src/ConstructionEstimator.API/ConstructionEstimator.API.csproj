<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>construction-estimator-dev</UserSecretsId>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConstructionEstimator.Application\ConstructionEstimator.Application.csproj" />
    <ProjectReference Include="..\ConstructionEstimator.Infrastructure\ConstructionEstimator.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Security pin: Swashbuckle brings in Microsoft.OpenApi 2.3.0, which has known vulnerability
         GHSA-v5pm-xwqc-g5wc (high, DoS via circular schema refs). Fixed in 2.7.5.
         Remove once Swashbuckle depends on a patched version. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>
</Project>
